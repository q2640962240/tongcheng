# ==========================================================================
# 白夜后端 · 生产级 .env 示例文件
# ==========================================================================
# 重要：
#   1. 本项目已移除所有 dev/mock 回退逻辑。短信/支付/推送/OSS 任一模块
#      未启用 + 未配置完整 → 对应接口将直接返回明确业务错误（提示管理
#      后台配置），不再静默模拟成功。
#   2. 所有敏感配置（密钥/证书/签名 Key）推荐在「管理后台 → 配置中心」
#      动态填写并保存；配置中心的优先级高于此处的 .env。
#   3. 生产环境请务必先执行 `node src/seed.js` 初始化管理员和配置中心
#      空模板，然后使用管理后台配置各模块参数。
# ==========================================================================

# ============ 服务 ============
PORT=3000
# 必须设为 production 以关闭任何调试行为
NODE_ENV=production
# CORS 白名单（逗号分隔；支持 * 二级通配如 https://*.yourdomain.com）
# 未设置时默认只放 APP_DOMAIN 的 origin；开发环境 origin=* 宽松允许
CORS_ORIGINS=https://baiye.yourdomain.com,https://admin.yourdomain.com

# ============ 数据库（生产强制使用 MySQL；开发/测试可 DB_DRIVER=json 回退本地文件）============
#   - NODE_ENV=production 时，DB_DRIVER 忽略，始终走真实 MySQL
#   - 建议 MySQL 8.0+ ；5.7 需要创建数据库时指定 CHARSET=utf8mb4
#   - 创建数据库示例：CREATE DATABASE companion_play DEFAULT CHARSET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=companion_play
DB_USER=root
DB_PASSWORD=your_password
DB_LOGGING=false
# 连接池（可选）
DB_POOL_MAX=20
DB_POOL_MIN=2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ JWT ============
# 必改：使用高强度随机字符串 (>= 32 位)
JWT_SECRET=please_change_to_a_strong_random_secret_at_least_32_bytes
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=please_change_to_a_strong_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ============ 应用信息 ============
# 可在管理后台「配置中心 → 应用」里覆盖
APP_NAME=白夜
# 生产域名必须配置（支付/短信回调、OSS 回源等需要）
APP_DOMAIN=https://baiye.yourdomain.com
APP_NOTICE=
KEFU_WECHAT=
KEFU_QRCODE=
KEFU_PHONE=

# ==========================================================================
# 第三方模块（以下均推荐在管理后台填写，本 .env 留占位符即可）
# ==========================================================================

# ============ 短信服务 ============
# 可选值: aliyun | tencent (留空 = 未启用, 登录接口将提示配置)
# 之前的 dev provider 已移除，不再支持控制台打印验证码
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=白夜
SMS_TEMPLATE_CODE=
SMS_TPL_REGISTER=
SMS_TPL_LOGIN=
# 腾讯云专用: SmsSdkAppId (即 sms.appId)
SMS_APP_ID=

# ============ 微信支付 ============
# 开关：必须 true 且 appId/mchId/mchKey/notifyUrl 都填才会真实下单
# 之前的 enabled=false 即 dev 自动充值直达钱包 的逻辑已彻底移除
WXPAY_ENABLED=false
WX_APP_ID=
WX_MCH_ID=
WX_MCH_KEY=
WX_NOTIFY_URL=https://baiye.yourdomain.com/api/wallet/wx-notify
# 推荐使用 certPrivateKey 直接粘贴 PEM；certPath 仅作兜底
WXPAY_CERT_PATH=
WXPAY_CERT_SERIAL=
WXPAY_CERT_PRIVATE_KEY=
WXPAY_PLATFORM_CERT=

# ============ 支付宝 ============
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://baiye.yourdomain.com/api/wallet/alipay-notify
ALIPAY_SANDBOX=false

# ============ 存储 ============
# local(单机生产可用) | aliyun
OSS_PROVIDER=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_CDN_DOMAIN=

# ============ 离线推送 ============
PUSH_ENABLED=false
# 可选: jpush | getui (留空或 none = 不启用)
PUSH_PROVIDER=
PUSH_APP_ID=
PUSH_CHANNEL_ID=
PUSH_APP_KEY=
PUSH_MASTER_SECRET=

# ==================== 已随 server/package.json 一并安装的生产依赖 ====================
# 本项目已将所有生产必需的第三方 SDK 写入 server/package.json 并完成安装：
#   axios                                                    # 微信支付 V3 / 极光 / 个推 REST API
#   @alicloud/dysmsapi20170525 + @alicloud/openapi-client    # 阿里云短信（官方 SDK）
#   tencentcloud-sdk-nodejs-sms                              # 腾讯云短信（官方 SDK）
#   alipay-sdk                                               # 支付宝官方 SDK
#   ali-oss                                                  # 阿里云 OSS 官方 SDK
#
# 生产部署时只需要执行 `cd server && npm install --production`，
# 然后登录管理后台「配置中心」填写对应模块参数即可，无需手动补装 SDK。
#
# 上线前必做：
#   1) 执行 `node src/seed.js` 初始化管理员 + 配置中心空模板
#   2) 浏览器打开管理后台 http://<你的后台域名>/dashboard ，账号 admin / admin123（立刻改密）
#   3) 进入「配置中心」，依次填写并测试以下模块：应用 / 短信 / 微信支付 / 支付宝 / OSS / 推送
#   4) H5 / 小程序 / App 侧 manifest.json 的 appid/域名/商务参数须自行在各平台控制台核对
